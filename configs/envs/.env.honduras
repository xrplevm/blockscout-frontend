# Banco Central de Honduras — CBDC explorer preset.
# Branding rebrand of the XRPL EVM (Peersyst) fork. Runs locally and reuses the
# public XRPL EVM testnet backend for data (no Honduras public backend yet).
# Run with: yarn dev:preset honduras

# --- App (local dev; no Honduras production host yet) ---
NEXT_PUBLIC_APP_PROTOCOL=http
NEXT_PUBLIC_APP_HOST=localhost
NEXT_PUBLIC_APP_PORT=3000
NEXT_PUBLIC_APP_ENV=development

# --- API: reuse the XRPL EVM testnet backend for data ---
NEXT_PUBLIC_API_PROTOCOL=https
NEXT_PUBLIC_API_HOST=explorer.testnet.xrplevm.org
NEXT_PUBLIC_API_BASE_PATH="/"
NEXT_PUBLIC_API_WEBSOCKET_PROTOCOL=wss
NEXT_PUBLIC_API_SPEC_URL="https://raw.githubusercontent.com/blockscout/blockscout-api-v2-swagger/main/swagger.yaml"
NEXT_PUBLIC_STATS_API_BASE_PATH=/
NEXT_PUBLIC_STATS_API_HOST=https://explorer-stats.testnet.xrplevm.org

# --- Network / currency (matches the reused testnet backend) ---
NEXT_PUBLIC_NETWORK_CURRENCY_DECIMALS=18
NEXT_PUBLIC_NETWORK_CURRENCY_NAME=XRP
NEXT_PUBLIC_NETWORK_CURRENCY_SYMBOL=XRP
NEXT_PUBLIC_NETWORK_ID="1449000"
NEXT_PUBLIC_NETWORK_NAME="Banco Central de Honduras"
NEXT_PUBLIC_NETWORK_SHORT_NAME="Honduras CBDC"
NEXT_PUBLIC_NETWORK_RPC_URL=https://rpc.testnet.xrplevm.org
NEXT_PUBLIC_NETWORK_VERIFICATION_TYPE=validation
NEXT_PUBLIC_IS_DEVNET=false
NEXT_PUBLIC_IS_TESTNET=true
NEXT_PUBLIC_IS_ACCOUNT_SUPPORTED=true

# --- Branding (Banco Central de Honduras seal) ---
NEXT_PUBLIC_NETWORK_LOGO=file://./public/cbdc/bank-logo-light.svg
NEXT_PUBLIC_NETWORK_LOGO_DARK=file://./public/cbdc/bank-logo-dark.svg
NEXT_PUBLIC_NETWORK_ICON=file://./public/cbdc/icon-light.svg
NEXT_PUBLIC_NETWORK_ICON_DARK=file://./public/cbdc/icon-dark.svg
NEXT_PUBLIC_OG_IMAGE_URL=file://./public/cbdc/logo.webp
NEXT_PUBLIC_OG_DESCRIPTION="Explorador de bloques del Banco Central de Honduras"
FAVICON_MASTER_URL=file://./public/cbdc/favicon.svg
NEXT_PUBLIC_PROMOTE_BLOCKSCOUT_IN_TITLE=false

# Default to light color mode
NEXT_PUBLIC_COLOR_THEME_DEFAULT=light

# Hero/plate use the brand teal (purple.* scale is remapped to Honduras teal in the theme)
NEXT_PUBLIC_HOMEPAGE_PLATE_BACKGROUND="radial-gradient(circle, rgba(5,69,104,1) 0%, rgba(3,58,86,1) 100%)"
NEXT_PUBLIC_HOMEPAGE_HERO_BANNER_CONFIG='{"background":["linear-gradient(135deg, #054568 0%, #0A5E8C 100%)","linear-gradient(135deg, #043652 0%, #054568 100%)"],"text_color":["#FFFFFF","#FFFFFF"],"button":{"_default":{"background":["rgba(255,255,255,0.15)","rgba(255,255,255,0.15)"],"text_color":["white","white"]},"_hover":{"background":["rgba(255,255,255,0.25)","rgba(255,255,255,0.25)"],"text_color":["#FFFFFF","#FFFFFF"]},"_selected":{"background":["rgba(255,255,255,0.25)","rgba(255,255,255,0.25)"],"text_color":["#FFFFFF","#FFFFFF"]}}}'
NEXT_PUBLIC_HOMEPAGE_CHARTS="['daily_txs']"
NEXT_PUBLIC_HOMEPAGE_STATS="['total_blocks', 'average_block_time', 'total_txs', 'wallet_addresses']"

# --- Features ---
NEXT_PUBLIC_OG_ENHANCED_DATA_ENABLED=true
NEXT_PUBLIC_TRANSACTION_INTERPRETATION_PROVIDER=blockscout
NEXT_PUBLIC_VIEWS_CONTRACT_SOLIDITYSCAN_ENABLED=true
NEXT_PUBLIC_HAS_BEACON_CHAIN=false
NEXT_PUBLIC_HIDE_INDEXING_ALERT_BLOCKS=true
NEXT_PUBLIC_GAS_TRACKER_ENABLED=false
NEXT_PUBLIC_MARKETPLACE_ENABLED=false
NEXT_PUBLIC_AD_BANNER_PROVIDER=none
NEXT_PUBLIC_AD_TEXT_PROVIDER=none
# Merits/rewards disabled (no NEXT_PUBLIC_REWARDS_SERVICE_API_HOST)
NEXT_PUBLIC_RE_CAPTCHA_APP_SITE_KEY="6LezTIYrAAAAAHfgP22woyrz7LUZbyBiNsHIY-Py"
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID="03f3d6961f421d54fd54512dc0189a02"
